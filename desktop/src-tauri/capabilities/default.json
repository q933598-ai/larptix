{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Larptrix desktop webview access to its local server and browser fallback.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8080/*",
      "http://localhost:8080/*",
      "http://*/*",
      "https://*/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-open-call-in-browser"
  ]
}